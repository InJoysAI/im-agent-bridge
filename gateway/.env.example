# Gateway Bearer Token — used by Bridge to authenticate inbound requests
GATEWAY_BEARER_TOKEN=your-gateway-bearer-token

# Optional: Bearer token for Gateway -> Bridge /bridge/reply
# Defaults to GATEWAY_BEARER_TOKEN when omitted
BRIDGE_BEARER_TOKEN=your-bridge-bearer-token

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/im_agent_bridge

# SQLx pool max connections (default: 100)
DB_MAX_CONNECTIONS=100

# Matterbridge base URL (Bridge Layer)
BRIDGE_URL=http://<edge-server-private-ip>:4242
