# LLM Provider
LLM_API_KEY=sk-your-llm-api-key

# Shopify MCP 凭证（多店铺，每个店铺一组变量）
# 变量命名规则：SHOPIFY_{STORE_SLUG_UPPER}_CLIENT_ID / _CLIENT_SECRET / _DOMAIN
# 店铺 Slug 规则：store slug 全大写并以 _ 替换 -（如 cool-gadgets → COOL_GADGETS）

# 店铺 1：store1（对应 mcpServers 条目 "shopify-store1"）
SHOPIFY_STORE1_CLIENT_ID=your-store1-client-id
SHOPIFY_STORE1_CLIENT_SECRET=your-store1-client-secret
SHOPIFY_STORE1_DOMAIN=store1.myshopify.com

# 店铺 2：store2（对应 mcpServers 条目 "shopify-store2"）
SHOPIFY_STORE2_CLIENT_ID=your-store2-client-id
SHOPIFY_STORE2_CLIENT_SECRET=your-store2-client-secret
SHOPIFY_STORE2_DOMAIN=store2.myshopify.com

# 如何增加第 N 个店铺：
# 1. 在此追加三行（将 STOREN 替换为实际 slug 大写形式）：
#    SHOPIFY_STOREN_CLIENT_ID=...
#    SHOPIFY_STOREN_CLIENT_SECRET=...
#    SHOPIFY_STOREN_DOMAIN=storen.myshopify.com
# 2. 在 config.json 的 tools.mcpServers 新增对应条目（shopify-storen），
#    args 中引用 ${SHOPIFY_STOREN_CLIENT_ID} 等变量
